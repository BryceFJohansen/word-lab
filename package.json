{
  "name": "word-lab",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dictionary:build": "tsx scripts/build-dictionary.ts",
    "dictionary:validate": "tsx scripts/validate-dictionary.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:performance": "tsx scripts/performance.ts"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.1"
  }
}
